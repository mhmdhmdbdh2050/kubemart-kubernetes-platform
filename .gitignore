# Environment variables and secrets
.env
.env.*
!.env.example

# Kubernetes local credentials
kubeconfig
*.kubeconfig

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/

# Temporary files
*.tmp
*.temp
*.swp
*~

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Generated files
dist/
build/

#frontend-secret-yaml
k8s/config/frontend-secret.yaml
k8s/config/postgres-secret.yaml

# Kubernetes secrets - never commit real credentials
k8s/config/*-secret.yaml
!k8s/config/*-secret.example.yaml

# Editor swap files
*.swp
*.swo

# Local backup files
*.bak
*.bak[0-9]
